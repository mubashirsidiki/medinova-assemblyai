# Workspace-level ignores for this multi-project repo

# Node dependencies (next-app, mongo-check, etc.)
**/node_modules/

# Build and cache outputs
**/.next/
**/out/
**/build/
**/dist/
**/coverage/
**/.cache/
**/*.tsbuildinfo

# Environment files (keep only examples in git)
**/.env
**/.env.*
!**/.env.example

# Local runtime and debug logs
*.log
**/server.out.log
**/server.err.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Local tooling metadata
.playwright-cli/
.playwright-mcp/
**/.vercel/

# OS/editor noise
.DS_Store
Thumbs.db

# Claude Code
.claude/

next-app/.mcp.json

next-app/skills-lock.json

lawlanesolicitors

skills-lock.json

.agents
agent/


.mypy_cache

.ruff_cache

docs/
medinova-livekit-agent/tests/
