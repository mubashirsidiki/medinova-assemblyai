# Auto detect text files and perform LF normalization
* text=auto

# Force CRLF for certain files that need it
*.{bat,cmd,ps1} text eol=crlf

# Denote all files that are truly binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.svg binary
