# -----------------------------------------------------------------------------
# Medinova Next.js Dashboard & Web Client Environment Variables
# -----------------------------------------------------------------------------

# MongoDB connection string for Prisma ORM
MONGODB_URI=

# LiveKit Cloud credentials (used by /api/livekit/token to generate WebRTC participant tokens)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared secret for agent -> dashboard webhook authentication (used by /api/livekit/notify)
# Must match the JWT_SECRET configured in medinova-livekit-agent
JWT_SECRET=

# Optional application URL
# NEXT_PUBLIC_APP_URL=
